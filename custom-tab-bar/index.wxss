.tb-wrap {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 900;
  pointer-events: none;
}

.tb-hidden { display: none; }

.tb-bar {
  margin: 0 20rpx 16rpx;
  background: #ffffff;
  border-radius: 40rpx;
  box-shadow: 0 6rpx 24rpx rgba(18, 46, 38, 0.10), 0 2rpx 6rpx rgba(18, 46, 38, 0.06);
  border: 1rpx solid rgba(18, 46, 38, 0.06);
  display: flex;
  align-items: flex-end;
  padding: 10rpx 8rpx 12rpx;
  pointer-events: auto;
}

.tb-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2rpx;
  padding: 8rpx 0 4rpx;
  border-radius: 32rpx;
  position: relative;
  transition: background-color 0.2s ease;
}

.tb-hover { background: rgba(11, 122, 98, 0.06); }

.tb-item.on { background: rgba(11, 122, 98, 0.10); }

.tb-icon {
  font-size: 40rpx;
  line-height: 1;
  opacity: 0.92;
}

.tb-text {
  font-size: 26rpx;
  font-weight: 500;
  line-height: 1.2;
  color: #9AA1A9;
}

.tb-item.on .tb-icon,
.tb-item.on .tb-text { color: #0B7A62; }

.tb-dot {
  position: absolute;
  top: 4rpx;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #0B7A62;
}
