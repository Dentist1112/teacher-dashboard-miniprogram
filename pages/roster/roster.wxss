/* 流派色：roster → 墨绿（四色体系内，vs和纸底对比度 ≥4.5）*/
page { --accent: #1D5AA0; }

.container { padding: 24rpx; }

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  /* 4 个入口按钮 + 标题一行放不下：实测 classTitle 被挤成逐字竖排。
     允许折行 → 标题独占第一行，按钮组整体掉第二行右对齐（不改配色/字号） */
  flex-wrap: wrap;
}
.header-title { flex: 1 1 100%; min-width: 0; }
.header-title .title { white-space: nowrap; font-size: 32rpx; }
.add-btn {
  background: var(--primary);
  color: #fff;
  font-size: 26rpx;
  padding: 16rpx 28rpx;
  border-radius: 999rpx;
  line-height: 1;
  white-space: nowrap;
}
.center-tip { text-align: center; padding: 40rpx 0; }

/* 列表行样式已迁入 app.wxss 的共享卡片列表（.cl / .cl-av / .cl-main / .cl-t / .cl-s / .cl-end）。
 * 改列表观感请改 app.wxss 那一处，所有页面同步生效，不要在本页另起一套。 */

/* 三个操作按钮挤在一行，收窄一点给姓名留位置 */
.cl-end .act { min-width: 72rpx; padding: 14rpx 16rpx; font-size: 24rpx; }

.act {
  font-size: 26rpx;
  padding: 16rpx 24rpx;
  border-radius: 12rpx;
  line-height: 1;
  min-width: 96rpx;
  text-align: center;
  box-sizing: border-box;
}
.act.edit { color: var(--gold); background: rgba(169,139,47,0.08); }
.act.del { color: var(--primary); background: rgba(185,65,46,0.08); }

.mask {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.45);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}
.form-sheet {
  width: 100%;
  max-width: 680rpx;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  /* 表单比屏幕高时必须能滚，否则底部「保存/发布」按钮被顶出可视区（用户实测反馈：通知加不了）*/
  max-height: 85vh;
  overflow-y: auto;
}
.form-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--primary);
  text-align: center;
  margin-bottom: 24rpx;
}
.field {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--sep);
  min-height: 88rpx;
  box-sizing: border-box;
}
.field-label {
  width: 120rpx;
  color: var(--text);
  font-size: 28rpx;
}
.field-input { flex: 1; font-size: 30rpx; color: var(--text); }
.field-picker { flex: 1; }
.picker-text { font-size: 30rpx; color: var(--text); }

.form-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 32rpx;
}
.btn-cancel {
  flex: 1;
  text-align: center;
  padding: 24rpx;
  border-radius: 12rpx;
  background: #f0ead8;
  color: var(--text);
  font-size: 30rpx;
}
.btn-save {
  flex: 1;
  text-align: center;
  padding: 24rpx;
  border-radius: 12rpx;
  background: var(--primary);
  color: #fff;
  font-size: 30rpx;
}
.btn-save.disabled { opacity: 0.6; }

/* 档案入口（第 3 个按钮，行内按钮变窄一点避免换行） */
.act.profile { color: var(--wisteria); background: rgba(107,76,138,0.08); }
.cl-end { flex-wrap: wrap; justify-content: flex-end; }

/* ==== 每页专属特色（accent）的可见落地 ====
 * 只用在「不压正文」的位置：标题前竖条、卡片顶线、激活态。
 * 不做大面积深色块 —— 那会把字压到看不清（contrast.py 会直接报红）。 */
.title {
  position: relative;
  padding-left: 20rpx;
}
.title::before {
  content: '';
  position: absolute;
  left: 0; top: 8rpx; bottom: 8rpx;
  width: 8rpx;
  border-radius: 4rpx;
  background: var(--accent);
}
.card { border-top: 2rpx solid var(--accent); }
.btn { background: var(--accent); }

/* tab 预留：自定义底部导航悬浮，正文底部留空 */
page .container { padding-bottom: calc(180rpx + env(safe-area-inset-bottom)); }

/* ===== 拍照导名单：确认表 =====
 * 视觉一律复用本页已有的 .mask / .form-sheet / .field / .btn-* ，
 * 这里只加「表格行」必需的排布，不新起一套配色体系。 */
.head-btns {
  display: flex;
  gap: 12rpx;
  align-items: center;
  flex: 1 1 100%;
  margin-top: 16rpx;
  /* 三个入口一行放不下（实测量到会挤压标题），允许折行到第二行，不改配色不改字号 */
  flex-wrap: wrap;
  justify-content: flex-end;
  flex-shrink: 0;
}
/* 粘贴名单弹层：复用 grades 页同名样式的规格，保持两页手感一致 */
.paste-area {
  width: 100%;
  min-height: 200rpx;
  box-sizing: border-box;
  padding: 18rpx;
  font-size: 27rpx;
  line-height: 1.5;
  background: var(--card-2);
  border: 1rpx solid var(--sep);
  border-radius: 16rpx;
}
.ai-btn { background: var(--indigo); }

.ai-sheet { max-height: 86vh; display: flex; flex-direction: column; }
.ai-tip {
  font-size: 23rpx;
  color: var(--text2);
  line-height: 1.6;
  margin-bottom: var(--sp-3);
}
.ai-sum { display: flex; gap: 10rpx; align-items: baseline; margin: var(--sp-2) 0; }
.ai-sum-ok { font-size: 26rpx; font-weight: 600; color: var(--primary); }
.ai-sum-bad { font-size: 24rpx; color: var(--danger); }

/* 30 人一屏放不下 → 滚动区，高度留给按钮 */
.ai-list { max-height: 52vh; }
.ai-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 14rpx 0;
  border-bottom: 1rpx dashed var(--sep);
}
.ai-no {
  width: 64rpx;
  flex-shrink: 0;
  font-size: 24rpx;
  color: var(--text3);
  text-align: center;
}
.ai-name {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: var(--text);
  background: var(--card-2);
  border-radius: var(--radius-s);
  padding: 12rpx 18rpx;
}
.ai-dup {
  flex-shrink: 0;
  font-size: 21rpx;
  /* 不用 --danger：压在 10% 红底上实测 4.48，差 0.02 不达 AA（contrast.py 抓的） */
  color: #A62F1F;
  background: rgba(194, 64, 46, 0.10);
  border-radius: 999rpx;
  padding: 4rpx 14rpx;
}
.ai-act {
  flex-shrink: 0;
  font-size: 24rpx;
  color: var(--indigo);
  padding: 10rpx 18rpx;
  border-radius: 12rpx;
  background: rgba(31, 90, 168, 0.08);
}
/* 跳过的行整体压暗，但文字仍需可读（不许用 opacity 把字压到看不清） */
.ai-row.ai-skip .ai-name { color: var(--text3); background: var(--bg); }

/* 弹层表单可滚动后，把操作条固定在弹层底部：老师滚到哪都能看到「保存/发布」
   （用户实测反馈 2026-09-06：新加通知时只能打字，找不到保存按钮）*/
.form-sheet .form-actions {
  position: sticky;
  bottom: 0;
  background: #fff;
  padding-bottom: 4rpx;
  z-index: 2;
}

/* ==== 2026-09-13 批量管理：多选 / 全选 / 删所选 / 清空全班 ==== */
.batch-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 16rpx;
}
.batch-left { display: flex; align-items: center; gap: 16rpx; flex: 1; min-width: 0; flex-wrap: wrap; }
.batch-count { font-size: 24rpx; white-space: nowrap; }
.batch-chip {
  font-size: 24rpx;
  color: var(--primary);
  background: rgba(11,122,98,0.08);
  border-radius: 999rpx;
  padding: 10rpx 24rpx;
  line-height: 1;
  white-space: nowrap;
}
.batch-right { display: flex; align-items: center; gap: 12rpx; }
.batch-btn {
  font-size: 24rpx;
  border-radius: 999rpx;
  padding: 12rpx 24rpx;
  line-height: 1;
  white-space: nowrap;
}
.batch-btn.danger { background: var(--danger); color: #fff; }
.batch-btn.danger-outline { color: var(--danger); background: rgba(194,64,46,0.08); }
.batch-btn.disabled { opacity: 0.45; pointer-events: none; }

/* 头部“批量管理”激活态沿用 .ai-btn 主色，这里只给一个描边观感 */
.add-btn.ai-btn-on { background: var(--pink-d); }

/* 批量行 */
.cl-batch { padding-left: 8rpx; }
.cl-check {
  width: 44rpx; height: 44rpx;
  border-radius: 50%;
  border: 3rpx solid #C9C2B2;
  color: #fff;
  font-size: 28rpx;
  line-height: 40rpx;
  text-align: center;
  box-sizing: border-box;
  flex-shrink: 0;
}
.cl-check.check-on { background: var(--primary); border-color: var(--primary); font-weight: 700; }
.cl-on { background: rgba(11,122,98,0.05); border-radius: 16rpx; }
