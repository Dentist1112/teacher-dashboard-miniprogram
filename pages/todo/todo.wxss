/* 流派色：todo → 暖橙（勾选完成的活力色，白底对比 4.8+）*/
page { --accent: #B5520A; }

.add-card { padding: 24rpx; }
.add-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.todo-input {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  color: var(--text);
  background: var(--wash);
  border-radius: 999rpx;
  padding: 20rpx 28rpx;
  box-sizing: border-box;
}
.add-btn {
  flex-shrink: 0;
  background: var(--accent);
  color: #fff;
  font-size: 28rpx;
  padding: 20rpx 36rpx;
  border-radius: 999rpx;
  line-height: 1;
}
.add-btn.disabled { opacity: 0.6; }
.date-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 16rpx;
  padding: 0 8rpx;
}
.date-chip {
  font-size: 26rpx;
  color: var(--text2);
  background: #FFFFFF;
  border: 2rpx solid #FBE9F0;
  border-radius: 999rpx;
  padding: 10rpx 24rpx;
}
.date-clear {
  font-size: 24rpx;
  color: var(--text2);
  text-decoration: underline;
}

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.header-title { flex: 1; min-width: 0; }

.grp-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 24rpx 8rpx 8rpx;
}
.grp-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
}
.grp-dot-overdue { background: #B9412E; }
.grp-dot-today { background: var(--accent); }
.grp-dot-later { background: #2F6FB2; }
.grp-dot-nodate { background: #9AA7A2; }
.grp-dot-done { background: #C9D6D1; }
.grp-title {
  font-size: 28rpx;
  color: #8A4A12;
}
.grp-count {
  font-size: 22rpx;
  color: var(--text2);
  background: var(--wash);
  border-radius: 999rpx;
  padding: 2rpx 14rpx;
}

.todo-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx;
}
.check {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 3rpx solid #D9C9BC;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #fff;
  box-sizing: border-box;
}
.check.checked {
  background: var(--accent);
  border-color: var(--accent);
}
.todo-main { flex: 1; min-width: 0; }
.todo-title {
  font-size: 30rpx;
  color: var(--text);
  line-height: 1.45;
  word-break: break-all;
}
.todo-title.done {
  color: #5F726C;
  text-decoration: line-through;
}
.todo-date {
  margin-top: 6rpx;
  font-size: 24rpx;
}
.d-overdue { color: #B9412E; }
.d-today { color: var(--accent); font-weight: 600; }
.d-later { color: #2F6FB2; }
.todo-del {
  flex-shrink: 0;
  font-size: 24rpx;
  color: #B9412E;
  background: rgba(185,65,46,0.08);
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  line-height: 1;
}

/* 每页专属特色：标题竖条 + 卡片顶线 + 主按钮（不压正文）*/
.title {
  position: relative;
  padding-left: 20rpx;
}
.title::before {
  content: '';
  position: absolute;
  left: 0; top: 8rpx; bottom: 8rpx;
  width: 8rpx;
  border-radius: 4rpx;
  background: var(--accent);
}
.card { border-top: 2rpx solid var(--accent); }
.btn { background: var(--accent); }

/* 自定义底部导航悬浮，正文底部留空 */
page .container { padding-bottom: calc(180rpx + env(safe-area-inset-bottom)); }
