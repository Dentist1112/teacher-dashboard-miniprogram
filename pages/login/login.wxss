/* 登录页：沿用主题 v2「薄荷×蜜桃」，不另起一套视觉。
 * accent 必须与其余 15 页互异（contrast.py 会挡）：取微信绿深一档 #04803F
 * （vs 白 5.04，实测达 AA；原生 #07C160 只有 2.38，配白字看不清，不能用）。 */
page { --accent: #04803F; }

.login-page { padding-top: 48rpx; }

.brand { text-align: center; padding: 24rpx 0 40rpx; }
.mogu-img-lg { display: block; width: 230rpx; height: 284rpx; margin: 0 auto var(--sp-3); }
.brand-title { font-size: 44rpx; letter-spacing: 4rpx; }
.brand .title { margin-bottom: 6rpx; }

.login-card { padding-bottom: var(--sp-4); }
.login-tip { line-height: 1.7; margin: var(--sp-2) 0 var(--sp-4); }

.avatar-row { display: flex; align-items: center; gap: var(--sp-3); margin-bottom: var(--sp-4); }

/* button 默认带边框和白底，必须清干净否则头像外面套一圈灰框 */
/* 同设置页：button 在 flex 行里会被默认 min-width 撑成椭圆，头像只贴左侧。锁正圆并禁伸缩。 */
.avatar-btn {
  width: 132rpx; height: 132rpx;
  min-width: 132rpx; max-width: 132rpx;
  flex: 0 0 132rpx;
  box-sizing: border-box;
  display: flex; align-items: center; justify-content: center;
  padding: 0; margin: 0;
  border: none; border-radius: 50%;
  background: var(--card-2);
  overflow: hidden;
  line-height: 1;
  font-size: 0;
}
.avatar-btn::after { border: none; }
.avatar-img { width: 100%; height: 100%; border-radius: inherit; display: block; }
.avatar-ph {
  width: 100%; height: 100%;
  display: flex; align-items: center; justify-content: center;
  font-size: 48rpx; line-height: 1;
  color: var(--accent);
  background: var(--card-2);
}

.avatar-hint { flex: 1; display: flex; flex-direction: column; gap: 6rpx; }
.avatar-hint-t { font-size: var(--fs-sub); font-weight: 600; color: var(--text); }

.field { margin-bottom: var(--sp-3); }
.field-label { font-size: var(--fs-sm); color: var(--text2); margin-bottom: var(--sp-1); }
.field-input {
  height: 88rpx;
  padding: 0 var(--sp-3);
  background: var(--card-2);
  border-radius: var(--radius-s);
  font-size: var(--fs-body);
  color: var(--text);
}

.login-actions { display: flex; flex-direction: column; align-items: center; gap: var(--sp-3); }
.btn-login {
  width: 100%;
  background: var(--accent);
  color: #fff;
  text-align: center;
  font-size: var(--fs-sub);
  font-weight: 600;
  padding: var(--sp-3) 0;
  border-radius: 999rpx;
  box-shadow: 0 4rpx 14rpx rgba(4, 128, 63, 0.20);
}
.btn-login.disabled { opacity: 0.6; }
.link-skip { font-size: var(--fs-sm); color: var(--text2); padding: var(--sp-1) var(--sp-3); }

.login-why { margin-top: var(--sp-3); }
.why-line { display: flex; align-items: flex-start; gap: var(--sp-2); margin-top: var(--sp-2); }
.why-ic { font-size: 30rpx; line-height: 1.6; }
.why-tx { flex: 1; font-size: var(--fs-sm); color: var(--text2); line-height: 1.7; }
